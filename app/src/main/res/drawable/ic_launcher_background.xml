<?xml version="1.0" encoding="utf-8"?>
<!--
  ╔══════════════════════════════════════════════╗
  ║  AgroSense — FONDO DEL ÍCONO                ║
  ║  Para cambiar colores modifica:             ║
  ║    android:startColor  → color del centro   ║
  ║    android:endColor    → color del borde    ║
  ║  Colores actuales: verde claro → verde oscuro ║
  ╚══════════════════════════════════════════════╝
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76"
                android:startColor="#43A047"
                android:endColor="#1B5E20"/>
        </aapt:attr>
    </path>

</vector>
