<?xml version="1.0" encoding="utf-8"?>
<!--
  ╔══════════════════════════════════════════════════════════════╗
  ║  AgroSense — LOGO (primer plano del ícono)                  ║
  ║                                                              ║
  ║  Diseño: hoja + señal WiFi = sensor agrícola conectado      ║
  ║                                                              ║
  ║  Para editar colores cambia android:fillColor / strokeColor ║
  ║  Actualmente todo en blanco (#FFFFFF) sobre fondo verde     ║
  ║                                                              ║
  ║  Zona segura del ícono: coordenadas 18–90 (72×72dp centro)  ║
  ╚══════════════════════════════════════════════════════════════╝
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ══ HOJA ══════════════════════════════════════════════════════
         Hoja estilizada apuntando hacia arriba.
         Curva izquierda y curva derecha se unen en la punta (42,28)
         y en la base (42,76).                                        -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 42,28
            C 20,32 18,72 42,76
            C 66,72 64,32 42,28
            Z"/>

    <!-- Nervio central de la hoja -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#CCFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 42,30 L 42,74"/>

    <!-- Nervios laterales izquierdos -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#AAFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 42,44 Q 34,46 30,52"/>
    <path
        android:fillColor="#00000000"
        android:strokeColor="#AAFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 42,56 Q 33,58 29,64"/>

    <!-- Nervios laterales derechos -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#AAFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 42,44 Q 50,46 54,52"/>
    <path
        android:fillColor="#00000000"
        android:strokeColor="#AAFFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 42,56 Q 51,58 55,64"/>

    <!-- Tallo -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M 42,76 Q 42,86 46,90"/>

    <!-- ══ SEÑAL WiFi (esquina superior derecha) ══════════════════════
         Representa la conectividad / sensor IoT.
         Centro de la señal: (75, 58) apuntando hacia arriba.
         Para mover la señal cambia las coordenadas de los arcos.      -->

    <!-- Punto central de la señal -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M 72.5,58
            A 2.5,2.5 0 1 0 77.5,58
            A 2.5,2.5 0 1 0 72.5,58
            Z"/>

    <!-- Arco interior (radio 7) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M 70.1,52.1 A 7,7 0 0 1 79.9,52.1"/>

    <!-- Arco medio (radio 13) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M 65.8,47.8 A 13,13 0 0 1 84.2,47.8"/>

    <!-- Arco exterior (radio 19) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M 61.6,43.6 A 19,19 0 0 1 88.4,43.6"/>

</vector>
